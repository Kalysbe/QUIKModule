# === Общее для всего монорепозитория (backend/, auctionModule/) ===

# Локальные копии / устаревшие папки (не в репозитории)
src/
frontend/

# Зависимости
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Переменные окружения (секреты) — храните .env только локально
.env
.env.local
.env.*.local
!.env.example

# Логи приложения (backend/logs) и PM2
logs/
*.log
pm2-*.log

# Файлы лимитов QUIK, генерируемые в рантайме (backend/lims) — сами .lim не коммитим,
# кроме случаев, когда это осознанно нужно; папку сохраняем через .gitkeep
backend/lims/*
!backend/lims/.gitkeep

# Тестовое покрытие
coverage/
.nyc_output/

# Сборки фронтенда (auctionModule/dist)
dist/
dist-ssr/
build/

# IDE / редакторы
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# PM2 runtime
.pm2/

# Тесты
*.test.js.snap

# Docker
docker-compose.override.yml
