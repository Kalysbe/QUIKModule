# Переменные для docker-compose.yml (порты на хосте).
# Скопируйте в .env в корне проекта, чтобы переопределить порты по умолчанию.
# Настройки самого backend (БД, JWT, FIX-гейтвей и т.д.) — в backend/.env (см. backend/.env.example).

# Порт backend на хосте (внутри контейнера всегда 5000)
BACKEND_PORT=5000

# Порт витрины аукционного модуля (nginx) на хосте (внутри контейнера всегда 80)
AUCTION_PORT=8080
